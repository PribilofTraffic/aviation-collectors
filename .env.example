# Settings for the aviation collectors.
#
# Copy the lines you need into the .env that sits next to your
# docker-compose.yml and fill in the values. The real .env is never committed.
# Anything left empty switches that feature off; only the first value is
# required.

# --- Required -------------------------------------------------------------

# Your ADS-B receiver's aircraft feed (tar1090 / readsb / dump1090-fa).
# Example: http://192.0.2.10:8080/data/aircraft.json
AVIATION_TAR1090_URL=

# --- Where things live on the host -----------------------------------------

# Folder the collectors write into (JSON feeds and adsb_history.db).
# Point your web server at it, or mount it into another container.
AVIATION_DATA_DIR=./aviation/data

# Folder holding site.json (your airports) and, optionally, known_aircraft.json.
AVIATION_CONFIG_DIR=./aviation/config

# Folder for the daily dated backups of the history database and ledgers.
# Put it on a different disk if you can. Empty = no backups.
AVIATION_BACKUP_DIR=
AVIATION_BACKUP_KEEP=3

# User and group the container runs as, so files it writes belong to you.
# Find yours with:  id -u  and  id -g
AVIATION_UID=1000
AVIATION_GID=1000

# --- Optional sources ------------------------------------------------------

# FlightAware AeroAPI key. Turns on the scheduled-arrivals feed and the
# arrival ledger. Every poll is billed by FlightAware (about $0.005 per
# airport board); see AVIATION_FLIGHTS_INTERVAL below.
AVIATION_FA_AEROAPI_KEY=

# A second receiver at the airport your scheduled flights depart from.
# Turns on "heard departing" sightings. Same kind of URL as above.
AVIATION_HUB_TAR1090_URL=

# aircraft-patterns container (circling / survey detections). Its
# /api/history address. The go-around and hold detector works without it.
AVIATION_PATTERNS_URL=

# ADSb-Vue container. Its /cone address. Turns on the reception-range feed.
AVIATION_COVERAGE_URL=

# --- Timing (seconds). The defaults are what the original site runs. --------

AVIATION_ADSB_INTERVAL=60
AVIATION_HUB_INTERVAL=120
AVIATION_PATTERNS_INTERVAL=300
AVIATION_COVERAGE_INTERVAL=1800
# 7200 = 12 polls a day. With two airports that is about $7 a month.
AVIATION_FLIGHTS_INTERVAL=7200
AVIATION_STATS_INTERVAL=21600
AVIATION_BACKUP_INTERVAL=86400

# Time zone, only if you do not set "timezone" in site.json.
# AVIATION_TZ=America/Anchorage
